# MerHouse local Docker Compose environment template.

MERHOUSE_POSTGRES_DB=merhouse
MERHOUSE_POSTGRES_USER=merhouse_local
MERHOUSE_POSTGRES_PASSWORD=replace-with-local-postgres-password

MERHOUSE_AUTH_JWT_SECRET=replace-with-local-jwt-secret-at-least-32-characters
MERHOUSE_AUTH_RECOVERY_EXPOSE_RESET_TOKEN=false
MERHOUSE_AUTH_SEED_ADMIN_ENABLED=false
MERHOUSE_AUTH_SEED_ADMIN_EMAIL=
MERHOUSE_AUTH_SEED_ADMIN_PASSWORD=
MERHOUSE_SWAGGER_ENABLED=true
MERHOUSE_BACKEND_PORT=8081
MERHOUSE_FRONTEND_PORT=3001
MERHOUSE_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost,ionic://localhost

MERHOUSE_DEPLOYMENT_PUBLIC=false
MERHOUSE_PUBLIC_FRONTEND_URL=http://localhost:${MERHOUSE_FRONTEND_PORT:-3001}
MERHOUSE_EMAIL_ENABLED=false
MERHOUSE_EMAIL_FROM=
MERHOUSE_EMAIL_REPLY_TO=
MERHOUSE_SMTP_HOST=localhost
MERHOUSE_SMTP_PORT=1025
MERHOUSE_SMTP_USERNAME=
MERHOUSE_SMTP_PASSWORD=
MERHOUSE_SMTP_AUTH=false
MERHOUSE_SMTP_STARTTLS_ENABLE=false
MERHOUSE_AGENT_MODE=deterministic
MERHOUSE_AGENT_MODEL_ENDPOINT=
MERHOUSE_AGENT_MODEL_NAME=
MERHOUSE_AGENT_TIMEOUT_SECONDS=15

# Firebase configuration (local emulators)
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=merhouse-local
FIREBASE_EMULATOR_HOST=firebase-emulators:9099
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulators:9099
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase client SDK (frontend) — emulator config
# VITE_FIREBASE_EMULATOR_HOST tells the client SDK to connect to the local
# Auth emulator instead of production Firebase. Use 127.0.0.1 (not localhost)
# on Windows to avoid IPv6 resolution issues with Docker port mapping.
VITE_FIREBASE_API_KEY=emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=merhouse-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=merhouse-local
VITE_FIREBASE_STORAGE_BUCKET=merhouse-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_EMULATOR_HOST=http://127.0.0.1:9099
