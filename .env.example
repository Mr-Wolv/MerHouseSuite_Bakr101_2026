# MerHouse local Docker Compose environment template.

MERHOUSE_POSTGRES_DB=merhouse
MERHOUSE_POSTGRES_USER=merhouse_local
MERHOUSE_POSTGRES_PASSWORD=replace-with-local-postgres-password

MERHOUSE_AUTH_JWT_SECRET=replace-with-local-jwt-secret-at-least-32-characters
MERHOUSE_AUTH_RECOVERY_EXPOSE_RESET_TOKEN=false
MERHOUSE_AUTH_SEED_ADMIN_ENABLED=false
MERHOUSE_AUTH_SEED_ADMIN_EMAIL=
MERHOUSE_AUTH_SEED_ADMIN_PASSWORD=
MERHOUSE_SWAGGER_ENABLED=true
MERHOUSE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost,ionic://localhost

MERHOUSE_DEPLOYMENT_PUBLIC=false
