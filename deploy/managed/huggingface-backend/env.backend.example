# MerHouse V17 Hugging Face Docker Space backend environment template.
# Put these values in the Space Settings page as variables or secrets.
# Do not commit real deployment values or copy provider logs into Git.

MERHOUSE_DEPLOYMENT_PUBLIC=true
MERHOUSE_PUBLIC_FRONTEND_URL=https://<firebase-host>.web.app
MERHOUSE_CORS_ALLOWED_ORIGINS=https://<firebase-host>.web.app,capacitor://localhost,ionic://localhost

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<neon-db>?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=<neon-user>
SPRING_DATASOURCE_PASSWORD=<set as secret>

MERHOUSE_AUTH_JWT_SECRET=<set as secret>
MERHOUSE_AUTH_SEED_ADMIN_ENABLED=false
MERHOUSE_AUTH_RECOVERY_EXPOSE_RESET_TOKEN=false

MERHOUSE_SWAGGER_ENABLED=false

MERHOUSE_EMAIL_ENABLED=false
MERHOUSE_EMAIL_PROVIDER=log
MERHOUSE_EMAIL_FROM=no-reply@example.invalid

MERHOUSE_AGENT_MODE=deterministic
MERHOUSE_AGENT_TIMEOUT_SECONDS=15

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=25 -XX:+ExitOnOutOfMemoryError
