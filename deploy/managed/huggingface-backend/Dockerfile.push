# MerHouse Backend — Pre-built image for direct registry push
# Use: docker build -t registry.hf.space/m7mdhbkr-merhouse-backend:latest -f Dockerfile.push .

FROM eclipse-temurin:21-jre

ENV SERVER_PORT=7860
ENV PORT=7860
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=25 -XX:+ExitOnOutOfMemoryError"

WORKDIR /app
COPY backend/target/merhouse-0.0.1-SNAPSHOT.jar /app/app.jar

EXPOSE 7860
CMD ["java", "-jar", "/app/app.jar"]
