# Copy to an ignored deployment env file on the VPS. Do not commit real values.

MERHOUSE_POSTGRES_DB=merhouse
MERHOUSE_POSTGRES_USER=merhouse_app
MERHOUSE_POSTGRES_PASSWORD=replace-with-private-production-database-credential
MERHOUSE_AUTH_JWT_SECRET=replace-with-private-production-jwt-secret-at-least-32-bytes
MERHOUSE_AUTH_RECOVERY_REQUEST_LIMIT=5
MERHOUSE_AUTH_RECOVERY_REQUEST_WINDOW_MINUTES=60

MERHOUSE_PUBLIC_FRONTEND_URL=https://app.example.com
MERHOUSE_FRONTEND_PUBLIC_API_URL=
MERHOUSE_CORS_ALLOWED_ORIGINS=https://app.example.com,capacitor://localhost,ionic://localhost
MERHOUSE_HTTP_BIND=127.0.0.1:3000
MERHOUSE_BACKUP_HOST_DIR=/opt/merhouse/backups

MERHOUSE_EMAIL_ENABLED=false
MERHOUSE_EMAIL_FROM=
MERHOUSE_EMAIL_REPLY_TO=
MERHOUSE_SMTP_HOST=smtp.gmail.com
MERHOUSE_SMTP_PORT=587
MERHOUSE_SMTP_USERNAME=
MERHOUSE_SMTP_PASSWORD=
MERHOUSE_SMTP_AUTH=true
MERHOUSE_SMTP_STARTTLS_ENABLE=true

MERHOUSE_AGENT_MODE=deterministic
MERHOUSE_AGENT_MODEL_ENDPOINT=
MERHOUSE_AGENT_MODEL_NAME=
MERHOUSE_AGENT_TIMEOUT_SECONDS=15
