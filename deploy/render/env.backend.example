# Render backend environment template. Do not commit real values.

MERHOUSE_DEPLOYMENT_PUBLIC=true
MERHOUSE_PUBLIC_FRONTEND_URL=https://<vercel-project>.vercel.app
MERHOUSE_CORS_ALLOWED_ORIGINS=https://<vercel-project>.vercel.app,capacitor://localhost,ionic://localhost

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<neon-db>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-user>
SPRING_DATASOURCE_PASSWORD=<neon-password>
MERHOUSE_AUTH_JWT_SECRET=<private-jwt-secret-at-least-32-bytes>

MERHOUSE_AUTH_RECOVERY_REQUEST_LIMIT=5
MERHOUSE_AUTH_RECOVERY_REQUEST_WINDOW_MINUTES=60
MERHOUSE_ACCESS_REQUEST_LIMIT=3
MERHOUSE_ACCESS_REQUEST_WINDOW_HOURS=24
MERHOUSE_SWAGGER_ENABLED=false
MERHOUSE_AUTH_RECOVERY_EXPOSE_RESET_TOKEN=false
MERHOUSE_AUTH_SEED_ADMIN_ENABLED=false

MERHOUSE_EMAIL_ENABLED=false
MERHOUSE_EMAIL_FROM=
MERHOUSE_EMAIL_REPLY_TO=
MERHOUSE_SMTP_HOST=smtp.gmail.com
MERHOUSE_SMTP_PORT=587
MERHOUSE_SMTP_USERNAME=
MERHOUSE_SMTP_PASSWORD=
MERHOUSE_SMTP_AUTH=true
MERHOUSE_SMTP_STARTTLS_ENABLE=true

MERHOUSE_AGENT_MODE=deterministic
MERHOUSE_AGENT_MODEL_ENDPOINT=
MERHOUSE_AGENT_MODEL_NAME=
MERHOUSE_AGENT_TIMEOUT_SECONDS=15
